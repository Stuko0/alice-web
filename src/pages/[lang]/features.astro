---
import Layout from "../../components/Layout.astro";
import { ScrollReveal } from "../../components/ScrollReveal";
import { FeatureCard } from "../../components/FeatureCard";
import { Sparkles, ArrowRight } from "lucide-react";
import { getT } from "../../i18n.server";

export const getStaticPaths = () => [{ params: { lang: "es" } }, { params: { lang: "en" } }, { params: { lang: "it" } }];

const lng = (Astro.currentLocale ?? "es") as "es" | "en" | "it";
const t = getT(lng);

const allFeatures = [
  { iconName: "Brain", title: t.features.persistentMemory, desc: t.features.persistentMemoryDesc },
  { iconName: "Eye", title: t.features.webBrowse, desc: t.features.webBrowseDesc },
  { iconName: "Heart", title: t.features.creative, desc: t.features.creativeDesc },
  { iconName: "Clock", title: t.features.scheduled, desc: t.features.scheduledDesc },
  { iconName: "Shield", title: t.features.sandbox, desc: t.features.sandboxDesc },
  { iconName: "Sparkles", title: t.features.astroIslands, desc: t.features.astroIslandsDesc },
  { iconName: "Terminal", title: t.features.cli, desc: t.features.cliDesc },
  { iconName: "Globe", title: t.features.integrations, desc: t.features.integrationsDesc },
  { iconName: "MessageSquare", title: t.features.contextual, desc: t.features.contextualDesc },
  { iconName: "Music", title: t.features.audio, desc: t.features.audioDesc },
  { iconName: "Palette", title: t.features.visual, desc: t.features.visualDesc },
  { iconName: "Code", title: t.features.code, desc: t.features.codeDesc },
];

const title = `${t.nav.features} — Alice Agent`;
---

<Layout title={title}>
  <section class="relative overflow-hidden border-b border-rpm-highlight-low/60 bg-rpm-base py-28">
    <div class="fabric-pattern"></div>
    <div class="section-vignette"></div>
    <div class="glow-orb glow-orb-1" style="background: var(--color-rpm-love)"></div>
    <div class="absolute top-20 left-8 text-6xl font-bold text-rpm-love/6 select-none hidden md:block" aria-hidden>♥</div>
    <div class="absolute bottom-20 right-8 text-6xl font-bold text-rpm-gold/6 select-none hidden md:block" aria-hidden>♣</div>

    <div class="relative mx-auto max-w-4xl px-6 text-center">
      <div class="header-ornate">
        <span class="suit-heart">♥</span>
        <span class="line" style="background: linear-gradient(90deg, transparent, var(--color-rpm-love))"></span>
        <span class="suit-spade">♠</span>
        <span class="line" style="background: linear-gradient(90deg, var(--color-rpm-love), transparent)"></span>
        <span class="suit-heart">♥</span>
      </div>
      <div class="inline-flex items-center gap-2 rounded-full border border-rpm-love/30 bg-rpm-love/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-rpm-love">
        <Sparkles class="h-3.5 w-3.5" />
        {t.featurePreview.badge}
        <span class="opacity-40" aria-hidden>♥</span>
      </div>
      <h1 class="mt-6 font-display text-5xl leading-tight text-rpm-text sm:text-6xl text-balance">{t.nav.features}</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-rpm-subtle">{t.featuresGrid.subtitle}</p>
    </div>
  </section>

  <section class="relative overflow-hidden bg-rpm-surface/20 py-24">
    <div class="fabric-pattern"></div>
    <div class="section-vignette"></div>

    <div class="mx-auto max-w-7xl px-6">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {allFeatures.map((f, i) => (
          <FeatureCard client:visible title={f.title} description={f.desc} iconName={f.iconName} index={i} />
        ))}
      </div>
    </div>
  </section>

  <!-- Deep dives -->
  <section id="deep-dive" class="relative overflow-hidden bg-rpm-base py-24">
    <div class="fabric-pattern"></div>
    <div class="section-vignette"></div>

    <div class="mx-auto max-w-7xl space-y-24 px-6">
      <!-- Kanban -->
      <ScrollReveal client:visible>
        <div class="grid items-center gap-10 lg:grid-cols-2">
          <div>
            <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-rpm-foam/30 bg-rpm-foam/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-widest text-rpm-foam">♠ Kanban</span>
            <h2 class="font-display text-3xl text-rpm-text text-balance">{t.deepDive.kanbanTitle}</h2>
            <p class="mt-4 leading-relaxed text-rpm-subtle">{t.deepDive.kanbanDesc}</p>
            <a href="https://alice-agent.stuko.dev/docs/user-guide/features/kanban" target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 rounded-full bg-rpm-iris px-5 py-2.5 font-medium text-rpm-base transition hover:bg-rpm-foam">
              {t.deepDive.learnMore} <ArrowRight class="h-4 w-4" />
            </a>
          </div>
          <div class="card-alice border-suit-spade bg-suit-spade">
            <span class="suit-watermark suit-spade">♠</span>
            <div class="p-4 pt-12">
              <img src="/img/kanban/01-board-overview.png" alt={t.deepDive.kanbanTitle} width="880" height="495" loading="lazy" class="w-full rounded-xl border border-rpm-highlight-med/40" />
            </div>
          </div>
        </div>
      </ScrollReveal>

      <!-- Dashboard -->
      <ScrollReveal client:visible>
        <div class="grid items-center gap-10 lg:grid-cols-2">
          <div class="order-2 lg:order-1 card-alice border-suit-heart bg-suit-heart">
            <span class="suit-watermark suit-heart">♥</span>
            <div class="p-4 pt-12">
              <img src="/img/dashboard/admin-sessions.png" alt={t.deepDive.dashboardTitle} width="960" height="540" loading="lazy" class="w-full rounded-xl border border-rpm-highlight-med/40" />
            </div>
          </div>
          <div class="order-1 lg:order-2">
            <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-rpm-love/30 bg-rpm-love/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-widest text-rpm-love">♥ Dashboard</span>
            <h2 class="font-display text-3xl text-rpm-text text-balance">{t.deepDive.dashboardTitle}</h2>
            <p class="mt-4 leading-relaxed text-rpm-subtle">{t.deepDive.dashboardDesc}</p>
            <a href="https://alice-agent.stuko.dev/docs/user-guide/features/web-dashboard" target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 rounded-full bg-rpm-iris px-5 py-2.5 font-medium text-rpm-base transition hover:bg-rpm-foam">
              {t.deepDive.learnMore} <ArrowRight class="h-4 w-4" />
            </a>
          </div>
        </div>
      </ScrollReveal>

      <!-- CLI -->
      <ScrollReveal client:visible>
        <div class="grid items-center gap-10 lg:grid-cols-2">
          <div>
            <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-rpm-gold/30 bg-rpm-gold/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-widest text-rpm-gold">♦ CLI</span>
            <h2 class="font-display text-3xl text-rpm-text text-balance">{t.deepDive.cliTitle}</h2>
            <p class="mt-4 leading-relaxed text-rpm-subtle">{t.deepDive.cliDesc}</p>
            <a href="https://alice-agent.stuko.dev/docs/user-guide/cli" target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 rounded-full bg-rpm-iris px-5 py-2.5 font-medium text-rpm-base transition hover:bg-rpm-foam">
              {t.deepDive.learnMore} <ArrowRight class="h-4 w-4" />
            </a>
          </div>
          <div class="card-alice border-suit-diamond bg-suit-diamond">
            <span class="suit-watermark suit-diamond">♦</span>
            <div class="p-4 pt-12">
              <img src="/img/docs/cli-layout.svg" alt={t.deepDive.cliTitle} loading="lazy" class="w-full rounded-xl border border-rpm-highlight-med/40 bg-rpm-base/60" />
            </div>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>
</Layout>
