---
import Layout from "../../../components/Layout.astro";
import { getCollection, render } from "astro:content";
import { getT } from "../../../i18n.server";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"));
  return posts.map((post) => ({
    params: {
      slug: post.id.replace(/-(en|es|it)$/, ""),
      lang: post.data.lang,
    },
    props: { post },
  }));
}

const lng = (Astro.currentLocale ?? "es") as "es" | "en" | "it";
const t = getT(lng);
const { post } = Astro.props;
const { Content } = await render(post);

const title = `${post.data.title} — Alice Agent`;
const canonical = `https://alice-agent.stuko.dev/${lng}/blog/${post.id.replace(/-(en|es|it)$/, "")}/`;
---

<Layout title={title} description={post.data.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    author: { "@type": "Person", name: "Stuko0" },
    publisher: { "@type": "Organization", name: "Alice Agent", url: "https://alice-agent.stuko.dev" },
    url: canonical,
    mainEntityOfPage: canonical,
  })} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `https://alice-agent.stuko.dev/${lng}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: `https://alice-agent.stuko.dev/${lng}/blog/` },
      { "@type": "ListItem", position: 3, name: post.data.title, item: canonical },
    ],
  })} />

  <article class="relative overflow-hidden bg-rpm-surface/20 py-24">
    <div class="fabric-pattern"></div>
    <div class="mx-auto max-w-3xl px-6">
      <nav class="mb-8 text-sm text-rpm-muted">
        <a href={`/${lng}/`} class="transition hover:text-rpm-iris">Home</a>
        <span class="mx-2">/</span>
        <a href={`/${lng}/blog/`} class="transition hover:text-rpm-iris">Blog</a>
        <span class="mx-2">/</span>
        <span class="text-rpm-subtle">{post.data.title}</span>
      </nav>

      <div class="flex items-center gap-3 text-xs text-rpm-muted">
        <time>{post.data.pubDate.toLocaleDateString(lng === "es" ? "es-ES" : lng === "it" ? "it-IT" : "en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
        {post.data.tags.map((tag) => (
          <span class="rounded-full border border-rpm-highlight-med/40 px-2 py-0.5 text-rpm-subtle">{tag}</span>
        ))}
      </div>

      <h1 class="mt-6 font-display text-4xl leading-tight text-rpm-text sm:text-5xl">{post.data.title}</h1>
      <p class="mt-4 text-lg text-rpm-subtle">{post.data.description}</p>

      <div class="prose prose-invert mt-12 max-w-none text-rpm-subtle">
        <Content />
      </div>

      <div class="mt-16 border-t border-rpm-highlight-low/60 pt-8">
        <a href={`/${lng}/blog/`} class="text-sm font-medium text-rpm-iris transition hover:text-rpm-foam">&larr; Back to blog</a>
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  .prose h2 { font-size: 1.5rem; font-weight: 600; margin-top: 2rem; margin-bottom: 1rem; color: var(--color-rpm-text); font-family: var(--font-display); }
  .prose h3 { font-size: 1.25rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.75rem; color: var(--color-rpm-text); }
  .prose p { margin-bottom: 1rem; line-height: 1.75; }
  .prose ul, .prose ol { margin-bottom: 1rem; padding-left: 1.5rem; }
  .prose li { margin-bottom: 0.5rem; line-height: 1.75; }
  .prose ul { list-style-type: disc; }
  .prose ol { list-style-type: decimal; }
  .prose a { color: var(--color-rpm-iris); text-decoration: underline; }
  .prose a:hover { color: var(--color-rpm-foam); }
  .prose code { background: var(--color-rpm-surface); padding: 0.15rem 0.4rem; border-radius: 0.375rem; font-size: 0.875rem; }
  .prose pre { background: var(--color-rpm-base); border: 1px solid color-mix(in srgb, var(--color-rpm-highlight-med) 40%, transparent); border-radius: 0.75rem; padding: 1.25rem; overflow-x: auto; margin-bottom: 1.5rem; }
  .prose pre code { background: none; padding: 0; }
  .prose table { width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; }
  .prose th, .prose td { padding: 0.75rem 1rem; border: 1px solid color-mix(in srgb, var(--color-rpm-highlight-med) 40%, transparent); text-align: left; }
  .prose th { background: var(--color-rpm-surface); font-weight: 600; }
  .prose strong { font-weight: 600; color: var(--color-rpm-text); }
  .prose blockquote { border-left: 3px solid var(--color-rpm-iris); padding-left: 1rem; margin: 1.5rem 0; color: var(--color-rpm-muted); }
</style>
