---
import { Download, Apple, Monitor, Terminal } from "lucide-react";
import { getLatestRelease } from "../lib/releases";

const release = await getLatestRelease();
---

<div class="mt-8 w-full max-w-2xl">
  <p class="mb-5 text-center text-sm font-medium uppercase tracking-widest text-rpm-muted">
    <span class="inline-flex items-center gap-2">
      <span class="h-px w-8 bg-rpm-highlight-med"></span>
      Or download the desktop app
      <span class="h-px w-8 bg-rpm-highlight-med"></span>
    </span>
  </p>
  <div class="grid grid-cols-3 gap-3">
    <!-- macOS → coming soon -->
    <div class="flex flex-col items-center gap-2 rounded-xl border border-rpm-highlight-med/30 bg-rpm-surface/60 px-4 py-4 opacity-60">
      <Apple class="h-6 w-6 text-rpm-muted" />
      <span class="text-xs font-medium text-rpm-muted">macOS</span>
      <span class="text-[10px] italic text-rpm-muted/60">Próximamente</span>
    </div>

    <!-- Windows → latest release (only if exe asset exists) -->
    {release.winExeUrl ? (
      <a
        href={release.winExeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col items-center gap-2 rounded-xl border border-rpm-love/40 bg-rpm-love/10 px-4 py-4 text-rpm-love transition hover:bg-rpm-love/20 hover:shadow-lg hover:-translate-y-1"
      >
        <Monitor class="h-6 w-6 transition group-hover:-translate-y-0.5" />
        <span class="text-xs font-medium">Windows</span>
        <span class="flex items-center gap-1 text-[10px] font-medium">
          <Download class="h-3 w-3" />
          {release.winExeName}
        </span>
        <span class="text-[10px] text-rpm-muted">v{release.version}</span>
      </a>
    ) : (
      <div class="flex flex-col items-center gap-2 rounded-xl border border-rpm-highlight-med/30 bg-rpm-surface/60 px-4 py-4 opacity-60">
        <Monitor class="h-6 w-6 text-rpm-muted" />
        <span class="text-xs font-medium text-rpm-muted">Windows</span>
        <span class="text-[10px] italic text-rpm-muted/60">Próximamente</span>
      </div>
    )}

    <!-- Linux → latest release -->
    <a
      href={release.linuxTarUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex flex-col items-center gap-2 rounded-xl border border-rpm-pine/40 bg-rpm-pine/10 px-4 py-4 text-rpm-pine transition hover:bg-rpm-pine/20 hover:shadow-lg hover:-translate-y-1"
    >
      <Terminal class="h-6 w-6 transition group-hover:-translate-y-0.5" />
      <span class="text-xs font-medium">Linux</span>
      <span class="flex items-center gap-1 text-[10px] font-medium">
        <Download class="h-3 w-3" />
        {release.linuxTarName}
      </span>
      <span class="text-[10px] text-rpm-muted">v{release.version}</span>
    </a>
  </div>
</div>
